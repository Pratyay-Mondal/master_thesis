@inproceedings{kirchenbauer2023watermark,
  author       = {John Kirchenbauer and Jonas Geiping and Yuxin Wen and Jonathan Katz and Ian Miers and Tom Goldstein},
  title        = {A Watermark for Large Language Models},
  booktitle    = {Proceedings of the 40th International Conference on Machine Learning (ICML 2023)},
  series       = {Proceedings of Machine Learning Research},
  volume       = {202},
  pages        = {17061--17084},
  year         = {2023},
  publisher    = {PMLR},
  url          = {https://proceedings.mlr.press/v202/kirchenbauer23a.html},
  annote       = {Foundational academic work introducing statistical green-list text watermarking. Formalizes pseudo-random vocabulary partitioning using a context-keyed hash function, soft logit bias $\delta$, and zero-shot hypothesis testing via a one-proportion $z$-test. Forms the algorithmic core modeled in the Week 3 simulator.}
}

@inproceedings{kirchenbauer2024reliability,
  author       = {John Kirchenbauer and Jonas Geiping and Yuxin Wen and Manli Shu and Khalid Saifullah and Kezhi Kong and Kasun Fernando and Aniruddha Saha and Tom Goldstein},
  title        = {On the Reliability of Watermarks for Large Language Models},
  booktitle    = {International Conference on Learning Representations (ICLR 2024)},
  year         = {2024},
  url          = {https://openreview.net/forum?id=v9eCSqU0wI},
  annote       = {Follow-up paper exploring watermark robustness and evasion attacks. Analyzes watermark survivability under paraphrase attacks, token substitutions, and cross-entropy variations, demonstrating that while short edits degrade $z$-scores gracefully, heavy rewriting collapses statistical significance.}
}

@article{dathathri2024synthid,
  author       = {Sumanth Dathathri and Andrea Banino and Sebastian Borgeaud and David Silver and Pushmeet Kohli and others},
  title        = {Scalable watermarking for identifying large language model outputs},
  journal      = {Nature},
  volume       = {634},
  number       = {8035},
  pages        = {818--823},
  year         = {2024},
  doi          = {10.1038/s41586-024-08025-4},
  annote       = {Introduces Google DeepMind's SynthID-Text system deployed on Gemini. Replaces explicit green-list logit shifting with multi-layer tournament sampling using $m$ pseudorandom $g$-functions. Demonstrates a distortion-free watermarking formulation compatible with speculative decoding and production throughput.}
}

@misc{anthropic_claude_watermark_2026,
