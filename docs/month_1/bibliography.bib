  title        = {Guidelines on Transparency Obligations for Providers and Deployers of Certain {AI} Systems under Article 50 of Regulation ({EU}) 2024/1689},
  institution  = {European Commission},
  year         = {2025},
  type         = {Regulatory Guidance Document},
  address      = {Brussels, Belgium},
  annote       = {Provides European Commission interpretive guidance on operationalizing Article 50. Elaborates on the statutory criteria 'effective, interoperable, robust, and reliable' for technical marking mechanisms, clarifies the interaction between provider marking duties and deployer disclosure exemptions, and outlines future standardization under Art. 50(7) implementing acts.}
}

