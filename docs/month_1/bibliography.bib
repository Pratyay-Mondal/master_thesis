@article{eu_ai_act_2024,
  author       = {{European Parliament and Council of the European Union}},
  title        = {Regulation ({EU}) 2024/1689 of the European Parliament and of the Council of 13 June 2024 laying down harmonised rules on artificial intelligence ({Artificial Intelligence Act}) and amending Regulations ({EC}) No 300/2008, ({EU}) No 167/2013, ({EU}) No 168/2013, ({EU}) 2018/858, ({EU}) 2018/1139 and ({EU}) 2019/2144 and Directives 2014/90/{EU}, ({EU}) 2016/797 and ({EU}) 2020/1828},
  journal      = {Official Journal of the European Union},
  volume       = {L 2024/1689},
  year         = {2024},
  pages        = {1--144},
  url          = {https://data.europa.eu/eli/reg/2024/1689/oj},
  annote       = {Primary statutory foundation of the thesis. Establishes the risk-based regulatory framework for AI within the European Union. Article 50 sets out binding transparency obligations for providers (Art. 50(2) machine-readable marking and detectability of synthetic media) and deployers (Art. 50(4) disclosure of deepfakes and public-interest text), while Art. 50(5) mandates clear, distinguishable presentation at first exposure.}
}

@techreport{eu_ai_office_guidelines_2025,
