{
  "manifest_version": 3,
  "name": "AI Transparency & Provenance Validator",
  "version": "0.1.0",
  "description": "Client-side provenance extraction and EU AI Act Article 50 transparency validator for social media platforms.",
  "author": "Pratyay Mondal <p.mondal@student.thws.de>",
  "icons": {
    "16": "public/icons/icon16.png",
    "48": "public/icons/icon48.png",
    "128": "public/icons/icon128.png"
  },
  "action": {
    "default_title": "AI Transparency Validator",
    "default_icon": {
      "16": "public/icons/icon16.png",
      "48": "public/icons/icon48.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://*.facebook.com/*",
    "*://*.instagram.com/*",
    "*://*.whatsapp.com/*",
    "*://localhost/*",
    "*://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "src/background/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.facebook.com/*",
        "*://*.instagram.com/*",
        "*://*.whatsapp.com/*",
        "*://localhost/*",
        "*://127.0.0.1/*",
        "file://*/*"
      ],
      "js": [
        "src/content/platform_adapters.js",
        "src/content/ui_injector.js",
        "src/content/content_script.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "public/icons/*",
        "src/content/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
